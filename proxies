      - "自动选择"
      - "DIRECT"

  - name: "📱 社交媒体"
    type: select
    proxies:
      - "🚀 主代理"
      - "自动选择"
      - "DIRECT"

  - name: "DNS_PROXY"
    type: select
    proxies:
      - "🚀 主代理"

