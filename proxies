# ====== 策略组 ======
proxy-groups:
  - name: "自动选择"
    type: url-test
    proxies:
      - "SSR节点"
      - "VLESS-xhttp-Reality-Vision"
      - "VMESS传输2-ipv6"
      - "Hysteria2节点3-ipv6"
      - "Hysteria2节点4-ipv4"
    url: "http://www.gstatic.com/generate_204"
    interval: 300
    tolerance: 50

  - name: "🚀 主代理"
    type: select
    proxies:
      - "自动选择"
      - "SSR节点"
      - "VLESS-xhttp-Reality-Vision"
      - "VMESS传输2-ipv6"
      - "Hysteria2节点3-ipv6"
      - "Hysteria2节点4-ipv4"
      - "DIRECT"

  - name: "🤖 AI服务"
    type: select
    proxies:
      - "🚀 主代理"
      - "自动选择"
      - "DIRECT"

  - name: "🌍 Google服务"
    type: select
    proxies:
      - "🚀 主代理"
      - "自动选择"
      - "DIRECT"

  - name: "🎬 流媒体"
    type: select
    proxies:
      - "🚀 主代理"
      - "自动选择"
      - "DIRECT"

  - name: "📱 社交媒体"
    type: select
    proxies:
      - "🚀 主代理"
      - "自动选择"
      - "DIRECT"

  - name: "DNS_PROXY"
    type: select
    proxies:
      - "🚀 主代理"

# ====== 规则 ======
rules:
