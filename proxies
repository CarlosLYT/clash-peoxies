# ====== 基础设置 ======
mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
external-controller: 127.0.0.1:9090

# ====== DNS 配置 ======
dns:
  enable: false
  listen: 0.0.0.0:53
  enhanced-mode: fake-ip
  nameserver:
    - 8.8.8.8
    - 114.114.114.114
  fallback:
    - tls://1.1.1.1:853
    - https://dns.google/dns-query

